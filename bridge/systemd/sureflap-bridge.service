[Unit]
Description=SureFlap ESP32-C5 Local Hub Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/unsure-hub/bridge
ExecStart=/usr/bin/python3 -u /opt/unsure-hub/bridge/sureflap_bridge.py -c /opt/unsure-hub/bridge/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
