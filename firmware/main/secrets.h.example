// Copy this file to secrets.h and fill in your network settings.
// secrets.h is git-ignored so credentials are never committed.
#pragma once

// Primary 5 GHz Wi-Fi (strongly recommended on ESP32-C5 so Wi-Fi does not
// contend with the 2.4 GHz IEEE 802.15.4 radio).
#define WIFI5_SSID       "Your5GHzSSID"
#define WIFI5_PASS       "Your5GHzPassword"

// Fallback 2.4 GHz Wi-Fi (used automatically if 5 GHz fails twice in a row).
// Set to the same SSID/password if you only run 2.4 GHz.
#define WIFI_SSID        "Your24GHzSSID"
#define WIFI_PASS        "Your24GHzPassword"

// Regulatory country code for Wi-Fi (e.g. "US", "GB", "DE", "AU")
#define WIFI_COUNTRY     "GB"

// IPv4 address of the host running sureflap_bridge.py (receives ZEP + status, serves OTA)
#define SINK_IP          "192.168.1.10"
#define OTA_PORT         8000

// 8-byte IEEE 802.15.4 extended address (EUI-64) advertised by this coordinator.
// The OUI 80:1f:12 matches Microchip (used by genuine SureFlap Hubs).
// Pick any unique last 3 bytes for your installation; once paired, keep them fixed.
#define HUB_EUI64_INIT   { 0x80, 0x1f, 0x12, 0xff, 0xfe, 0x00, 0x01, 0x02 }
